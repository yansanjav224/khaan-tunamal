# Утгуудыг Firebase Console → Project settings → Your apps → SDK setup
# хэсгээс хуулна. Эдгээр нь нууц биш — Firebase-ийн вэб түлхүүрүүд хөтөч рүү
# зориулагдсан, өгөгдлийг firestore.rules хамгаалдаг.
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=

# Cloudinary → Settings → Upload → Upload presets (unsigned)
NUXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NUXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Домэйн холбосны дараа заавал бөглөнө: canonical, sitemap, og:image,
# JSON-LD бүгд эндээс гарна. Хоосон бол Vercel-ийн үндсэн хаягийг ашиглана.
NUXT_PUBLIC_SITE_URL=

# Сонголт
NUXT_PUBLIC_GSC_VERIFICATION=
NUXT_PUBLIC_GA_MEASUREMENT_ID=
